# Copiar a .env en el VPS. Este archivo no se sube al repositorio.
# En Docker lo lee docker-compose.yml vía env_file.

# Dominios que la app acepta. Cualquier otro Host se rechaza.
LOPIANA_HOSTS=lopianaclothes.com,www.lopianaclothes.com

# 1 cuando está detrás de HTTPS: marca la cookie del panel como Secure y activa HSTS.
LOPIANA_HTTPS=1

# 1 cuando hay un proxy adelante (Caddy/nginx): la IP real se lee de X-Forwarded-For.
# Si algún día se expone uvicorn directo a internet, poner 0.
LOPIANA_TRUST_PROXY=1

# PIN inicial del panel, solo se usa la primera vez que arranca sobre una base vacía.
# Si se deja sin definir, queda "1234" y el panel obliga a cambiarlo al primer ingreso.
LOPIANA_ADMIN_PIN=
